int hammingDistance(int x, int y) {
    // XOR finds all positions where bits are different
    int xor_result = x ^ y;
    int distance = 0;
    
    // Count the number of set bits (1s) in xor_result
    while (xor_result > 0) {
        // Clear the lowest set bit
        xor_result = xor_result & (xor_result - 1);
        distance++;
    }
    
    return distance;
}
