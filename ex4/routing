#include <stdio.h>
#include <stdlib.h>

#define MAX_NODES 10
#define MAX_EDGES 45
#define INF 999

// Structure to explicitly define a network link edge
struct Edge {
    int source;
    int destination;
    int weight;
};

int costMatrix[MAX_NODES][MAX_NODES];
struct Edge edgeList[MAX_EDGES];
int numNodes = 0;
int numEdges = 0;

// Structure to hold individual routing tables for Distance Vector
struct DVRTable {
    int distance[MAX_NODES];
    int nextHop[MAX_NODES];
} dvrTable[MAX_NODES];

// Initialize matrix with defaults
void initializeNetwork() {
    int i, j;
    for (i = 0; i < numNodes; i++) {
        for (j = 0; j < numNodes; j++) {
            if (i == j) costMatrix[i][j] = 0;
            else costMatrix[i][j] = INF;
        }
    }
}

// Map structured Edges into global cost matrix layout
void buildCostMatrixFromEdges() {
    int i;
    initializeNetwork();
    for (i = 0; i < numEdges; i++) {
        int u = edgeList[i].source - 1; // 1-based index conversion to 0-based
        int v = edgeList[i].destination - 1;
        int w = edgeList[i].weight;
        costMatrix[u][v] = w;
        costMatrix[v][u] = w; // Assuming an undirected graph network
    }
}

// ======== MODULE 1: DISTANCE VECTOR ROUTING (Bellman-Ford) ========
void computeDistanceVector() {
    int i, j, k, count;
    
    // Setup initial table local metrics
    for (i = 0; i < numNodes; i++) {
        for (j = 0; j < numNodes; j++) {
            dvrTable[i].distance[j] = costMatrix[i][j];
            if (costMatrix[i][j] != INF && i != j) dvrTable[i].nextHop[j] = j;
            else dvrTable[i].nextHop[j] = -1;
        }
    }

    // Converge algorithm until state tracking stabilizes
    do {
        count = 0;
        for (i = 0; i < numNodes; i++) {
            for (j = 0; j < numNodes; j++) {
                for (k = 0; k < numNodes; k++) {
                    if (costMatrix[i][k] != INF && dvrTable[k].distance[j] != INF) {
                        if (dvrTable[i].distance[j] > costMatrix[i][k] + dvrTable[k].distance[j]) {
                            dvrTable[i].distance[j] = costMatrix[i][k] + dvrTable[k].distance[j];
                            dvrTable[i].nextHop[j] = k;
                            count++;
                        }
                    }
                }
            }
        }
    } while (count != 0);
}

void displayDVRResults() {
    int i, j;
    computeDistanceVector();
    printf("\n=============================================");
    printf("\n       DISTANCE VECTOR ROUTING TABLES        ");
    printf("\n=============================================");
    for (i = 0; i < numNodes; i++) {
        printf("\nRouting Table for Router %d:\n", i + 1);
        printf("Dest\tDistance\tNext Hop\n");
        for (j = 0; j < numNodes; j++) {
            printf("%d\t", j + 1);
            if (dvrTable[i].distance[j] == INF) printf("INF\t\t-\n");
            else if (i == j) printf("0\t\tSelf\n");
            else printf("%d\t\t%d\n", dvrTable[i].distance[j], dvrTable[i].nextHop[j] + 1);
        }
    }
}

// ======== MODULE 2: LINK STATE ROUTING (Dijkstra) ========
void computeLinkState(int sourceNode) {
    int distance[MAX_NODES];
    int visited[MAX_NODES];
    int nextHop[MAX_NODES];
    int i, count, minDistance, nextNode, j;

    for (i = 0; i < numNodes; i++) {
        distance[i] = costMatrix[sourceNode][i];
        visited[i] = 0;
        if (costMatrix[sourceNode][i] != INF && i != sourceNode) nextHop[i] = i;
        else nextHop[i] = -1;
    }

    distance[sourceNode] = 0;
    visited[sourceNode] = 1;
    count = 1;

    while (count < numNodes) {
        minDistance = INF;
        nextNode = -1;

        for (i = 0; i < numNodes; i++) {
            if (!visited[i] && distance[i] < minDistance) {
                minDistance = distance[i];
                nextNode = i;
            }
        }

        if (nextNode == -1) break;

        visited[nextNode] = 1;
        count++;

        for (j = 0; j < numNodes; j++) {
            if (!visited[j] && costMatrix[nextNode][j] != INF) {
                if (distance[nextNode] + costMatrix[nextNode][j] < distance[j]) {
                    distance[j] = distance[nextNode] + costMatrix[nextNode][j];
                    if (nextNode == sourceNode) nextHop[j] = j;
                    else nextHop[j] = nextHop[nextNode];
                }
            }
        }
    }

    printf("\nRouting Table for Router %d:\n", sourceNode + 1);
    printf("Dest\tDistance\tNext Hop\n");
    for (i = 0; i < numNodes; i++) {
        printf("%d\t", i + 1);
        if (distance[i] == INF) printf("INF\t\t-\n");
        else if (i == sourceNode) printf("0\t\tSelf\n");
        else printf("%d\t\t%d\n", distance[i], nextHop[i] + 1);
    }
}

void displayLSRResults() {
    int i;
    printf("\n=============================================");
    printf("\n          LINK STATE ROUTING TABLES          ");
    printf("\n=============================================");
    for (i = 0; i < numNodes; i++) {
        computeLinkState(i);
    }
}

// ======== UPGRADED MODULE 3: DETAILED DYNAMIC COST UPDATE ENGINE ========
void updateEdgeCost() {
    int u, v, newWeight, i, found = 0;
    int oldWeight = 0;

    printf("\n=============================================");
    printf("\n         DYNAMIC LINK COST UPDATE ENGINE     ");
    printf("\n=============================================");
    
    // Step 1: Print active links so the user knows what can be edited
    printf("\n\n[Current Active Links in the Network]:\n");
    printf("Link #\tSource\tDestination\tCurrent Cost\n");
    printf("---------------------------------------------\n");
    for (i = 0; i < numEdges; i++) {
        printf("%d\tRouter %d\tRouter %d\t%d\n", 
               i + 1, edgeList[i].source, edgeList[i].destination, edgeList[i].weight);
    }
    printf("---------------------------------------------\n");

    // Step 2: Accept targets for adjustment
    printf("\nEnter the connection details to modify:\n");
    printf("Enter Source Router (1-%d): ", numNodes);
    scanf("%d", &u);
    printf("Enter Destination Router (1-%d): ", numNodes);
    scanf("%d", &v);
    printf("Enter New Link Cost (or %d for a broken/cut link): ", INF);
    scanf("%d", &newWeight);

    // Step 3: Search, update, and display the comparative summary
    for (i = 0; i < numEdges; i++) {
        if ((edgeList[i].source == u && edgeList[i].destination == v) ||
            (edgeList[i].source == v && edgeList[i].destination == u)) {
            
            oldWeight = edgeList[i].weight;
            edgeList[i].weight = newWeight;
            found = 1;
            
            // Re-sync underlying framework cost matrix grid
            buildCostMatrixFromEdges(); 
            
            printf("\n>>> SUCCESS: Network topology updated! <<<\n");
            printf("Link [Router %d <-> Router %d]: Changed Cost from (%d) to (%d)\n", u, v, oldWeight, newWeight);
            break;
        }
    }

    if (!found) {
        printf("\n>>> ERROR: Link between Router %d and Router %d does not exist! <<<\n", u, v);
        return;
    }

    // Step 4: Show the updated raw topology matrix for visual confirmation
    printf("\n[Refreshed Network Link Adjacency Matrix]:\n\t");
    for (i = 0; i < numNodes; i++) {
        printf("R%d\t", i + 1);
    }
    printf("\n");
    for (i = 0; i < numNodes; i++) {
        printf("R%d\t", i + 1);
        for (int j = 0; j < numNodes; j++) {
            if (costMatrix[i][j] == INF) printf("INF\t");
            else printf("%d\t", costMatrix[i][j]);
        }
        printf("\n");
    }
}

// ======== MAIN MENUIZED INTERFACE LOOP ========
int main() {
    int i, choice;

    printf("Enter the number of nodes (max %d): ", MAX_NODES);
    scanf("%d", &numNodes);

    printf("Enter the number of edges: ");
    scanf("%d", &numEdges);

    printf("Enter edges format (Source Destination Weight) using 1-based indexing:\n");
    for (i = 0; i < numEdges; i++) {
        scanf("%d %d %d", &edgeList[i].source, &edgeList[i].destination, &edgeList[i].weight);
    }

    buildCostMatrixFromEdges();

    while (1) {
        printf("\n\n=========================================");
        printf("\n          ROUTING SIMULATOR MENU         ");
        printf("\n=========================================");
        printf("\n1. Run Distance Vector Routing (DVR)");
        printf("\n2. Run Link State Routing (LSR)");
        printf("\n3. Update an Edge Cost");
        printf("\n4. Exit Program");
        printf("\n=========================================");
        printf("\nEnter your choice (1-4): ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                displayDVRResults();
                break;
            case 2:
                displayLSRResults();
                break;
            case 3:
                updateEdgeCost();
                break;
            case 4:
                printf("\nExiting Routing Simulation program. Goodbye!\n");
                exit(0);
            default:
                printf("\nInvalid choice! Please select an option between 1 and 4.\n");
        }
    }

    return 0;
}

