#include <stdio.h>
#include <stdlib.h>

// Helper macro to find the maximum of two numbers
#define MAX(a, b) ((a) > (b) ? (a) : (b))

void riddle(int n, int* arr) {
    // Arrays to store the boundaries of the window where arr[i] is the minimum
    int* left = (int*)malloc(n * sizeof(int));
    int* right = (int*)malloc(n * sizeof(int));
    
    // Stack to store indices for finding previous/next smaller elements
    int* stack = (int*)malloc(n * sizeof(int));
    int top = -1;

    // Step 1: Find the index of the previous smaller element for every element
    for (int i = 0; i < n; i++) {
        while (top >= 0 && arr[stack[top]] >= arr[i]) {
            top--;
        }
        left[i] = (top == -1) ? -1 : stack[top];
        stack[++top] = i;
    }

    // Clear stack for the next pass
    top = -1;

    // Step 2: Find the index of the next smaller element for every element
    for (int i = n - 1; i >= 0; i--) {
        while (top >= 0 && arr[stack[top]] >= arr[i]) {
            top--;
        }
        right[i] = (top == -1) ? n : stack[top];
        stack[++top] = i;
    }

    // Step 3: ans[len] will store the max of min for window size 'len'
    // Initialize ans array with 0 (since window size is 1-indexed, size is n + 1)
    int* ans = (int*)calloc((n + 1), sizeof(int));

    for (int i = 0; i < n; i++) {
        // Length of the window where arr[i] is the minimum
        int len = right[i] - left[i] - 1;
        
        // Update the maximum minimum for this specific window length
        ans[len] = MAX(ans[len], arr[i]);
    }

    // Step 4: Fill entries for missing window sizes.
    // If a value is a max-min for a larger window, it can also be for a smaller window.
    for (int i = n - 1; i >= 1; i--) {
        ans[i] = MAX(ans[i], ans[i + 1]);
    }

    // Print the final result from window size 1 to n
    for (int i = 1; i <= n; i++) {
        printf("%d", ans[i]);
        if (i < n) {
            printf(" ");
        }
    }
    printf("\n");

    // Free dynamically allocated memory
    free(left);
    free(right);
    free(stack);
    free(ans);
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;

    int* arr = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) != 1) return 0;
    }

    riddle(n, arr);

    free(arr);
    return 0;
}
